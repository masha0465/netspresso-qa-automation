# Copy to .env (never commit .env). Only needed for real NetsPresso experiments
# executed from the Python 3.11 environment (.venv-netspresso) via
# scripts/run_real_netspresso.py --confirm-credit-use (explicit approval; used twice in total).
# The main QA framework, pytest and CI never read this key.
NETSPRESSO_API_KEY=
# Optional: disable SDK analytics events (behaviour observed in netspresso 1.17.0 source)
GA_DISABLE_ANALYTICS=1
